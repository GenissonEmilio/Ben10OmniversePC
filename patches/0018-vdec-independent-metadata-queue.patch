diff --git a/libs/codec/cellVdec.c b/libs/codec/cellVdec.c
index 204a005..df6f7d1 100644
--- a/libs/codec/cellVdec.c
+++ b/libs/codec/cellVdec.c
@@ -32,6 +32,7 @@ typedef struct {
     CellVdecPicItem item;
     int pictType;       /* 1 I, 2 P, 3 B, 0 unknown */
     int key;
+    int itemSeen;      /* metadata consumed independently from pixel output */
     u32 frameTicks;     /* one frame, 90 kHz (0 unknown) */
 } VdecPic;
 
@@ -105,7 +106,10 @@ static void vdec_on_picture(void* ctx, const VdecFfPicture* pic)
     q->frameTicks = pic->frame_ticks;
     q->item.codecType = v->codecType;
     q->item.startAddr = au->startAddr;
-    q->item.size      = au->size;
+    /* The picture item describes decoded planar output, not its compressed
+     * access unit. Players use this size when allocating the output buffer. */
+    q->item.size = (pic->width * pic->height +
+                    2u * ((pic->width + 1u) / 2u) * ((pic->height + 1u) / 2u) + 127u) & ~127u;
     q->item.auNum     = pic->token;
     /* An AU without a time stamp (both words 0xFFFFFFFF, as GoW:A's demuxer
      * sends every one of them) gets the next one on the stream's clock; a
@@ -343,13 +347,14 @@ s32 cellVdecDecodeAu(CellVdecHandle handle, s32 mode, const CellVdecAuInfo* auIn
  * +0x30 u64 auUserData[2], +0x40 status, +0x44 attr (0 normal, 1 skipped),
  * +0x48 picInfo. CellVdecAvcInfo and CellVdecMpeg2Info both begin with
  * u16 horizontalSize, u16 verticalSize; the rest of the info block is zero. */
-#define VDEC_ITEM_EA(h)  (VM_HLE_INJECT_BASE + 0x50000u + (u32)(h) * 0x100u)
+#define VDEC_SLOT_EA(h,s) (VM_HLE_INJECT_BASE + 0x50000u + ((u32)(h) * VDEC_QUEUE + (u32)(s)) * 0x100u)
+#define VDEC_ITEM_EA(h)  VDEC_SLOT_EA(h,0)
 #define VDEC_INFO_EA(h)  (VDEC_ITEM_EA(h) + 0x80u)
 
-static void vdec_write_item(CellVdecHandle handle, const CellVdecPicItem* p)
+static void vdec_write_item(CellVdecHandle handle, const CellVdecPicItem* p, u32 slot)
 {
     const VdecSlot* v = &s_vdec[handle];
-    u32 it = VDEC_ITEM_EA(handle), info = VDEC_INFO_EA(handle);
+    u32 it = VDEC_SLOT_EA(handle,slot), info = it + 0x80u;
     for (u32 o = 0; o < 0x100; o += 4) vm_write32(it + o, 0);
     vm_write32(it + 0x00, v->codecType);
     vm_write32(it + 0x04, p->startAddr);
@@ -378,9 +383,9 @@ static void vdec_write_item(CellVdecHandle handle, const CellVdecPicItem* p)
  *         +0x06 u8 idrPictureFlag;
  *   MPEG2 +0x12 u8 picture_coding_type[2] (1 I, 2 P, 3 B, as in the bitstream).
  * pict_type is FFmpeg's (1 I, 2 P, 3 B, 0 none). */
-static void vdec_write_pic_type(CellVdecHandle handle, const VdecPic* q)
+static void vdec_write_pic_type(CellVdecHandle handle, const VdecPic* q, u32 slot)
 {
-    u32 info = VDEC_INFO_EA(handle);
+    u32 info = VDEC_SLOT_EA(handle,slot) + 0x80u;
     int t = q->pictType;
     if (s_vdec[handle].codecType == CELL_VDEC_CODEC_TYPE_AVC) {
         vm_write8(info + 0x04, (u8)(t >= 1 && t <= 3 ? t - 1 : 3));
@@ -408,26 +413,31 @@ static void vdec_write_pic_type(CellVdecHandle handle, const VdecPic* q)
     }
 }
 
-/* cellVdecGetPicItem(handle, &item): the NEXT picture's item, without
- * consuming it; cellVdecGetPicture is what takes it off the queue. */
+/* Metadata and pixels have independent consumers. GetPicItem advances to
+ * the next unreported picture; GetPicture later consumes its pixels in FIFO
+ * order. Keep each metadata block stable until its picture slot is reused. */
 s32 cellVdecGetPicItem(CellVdecHandle handle, const CellVdecPicItem** picItem)
 {
     u32 out = (u32)(uintptr_t)picItem;
     if (handle >= MAX_VDEC || !s_vdec[handle].in_use || !out)
         return (s32)CELL_VDEC_ERROR_ARG;
-    const VdecSlot* v = &s_vdec[handle];
+    VdecSlot* v = &s_vdec[handle];
     if (v->ff) {
-        if (!v->qCount)
-            return (s32)CELL_VDEC_ERROR_EMPTY;
-        const VdecPic* q = &v->queue[v->qHead];
-        vdec_write_item(handle, &q->item);
-        vdec_write_pic_type(handle, q);
-        vm_write32(out, VDEC_ITEM_EA(handle));
-        return CELL_OK;
+        for (u32 n = 0; n < v->qCount; ++n) {
+            u32 slot = (v->qHead + n) % VDEC_QUEUE;
+            VdecPic* q = &v->queue[slot];
+            if (q->itemSeen) continue;
+            vdec_write_item(handle, &q->item, slot);
+            vdec_write_pic_type(handle, q, slot);
+            q->itemSeen = 1;
+            vm_write32(out, VDEC_SLOT_EA(handle,slot));
+            return CELL_OK;
+        }
+        return (s32)CELL_VDEC_ERROR_EMPTY;
     }
     if (!s_vdec[handle].hasPic)
         return (s32)CELL_VDEC_ERROR_EMPTY;
-    vdec_write_item(handle, &v->lastPic);
+    vdec_write_item(handle, &v->lastPic, 0);
     vm_write32(out, VDEC_ITEM_EA(handle));
     return CELL_OK;
 }
