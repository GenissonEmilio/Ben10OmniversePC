+++ b/libs/system/cellSaveData.c
@@ -1143,7 +1143,15 @@ static s32 savedata_fixed(int is_save, CellSaveDataSetList* setList,
     u32 cb = scratch_alloc(SAVEDATA_CBRESULT_SIZE);
     u32 get = scratch_alloc(0x4C); /* dirNum, dirListNum, dirList, reserved[64] */
     u32 set = scratch_alloc(12);   /* dirName, newIcon, option */
-    u32 list = listed ? scratch_alloc(listed * 48) : 0;
+    /* The supplied buffer owns the directory list. Some callers enumerate in
+     * funcFixed, then consume those names after this operation returns. */
+    u32 list = 0;
+    if (listed) {
+        u32 be = (u32)(uintptr_t)setBuf;
+        u32 capacity = vm_read32(be + 32), buffer = vm_read32(be + 36);
+        if (buffer && capacity >= listed * 48u) list = buffer;
+        else list = scratch_alloc(listed * 48u);
+    }
     if (!cb || !get || !set || (listed && !list)) {
         free(dirs); return CELL_SAVEDATA_ERROR_INTERNAL;
     }
@@ -1564,6 +1572,47 @@ void ps3_savedata_list_auto_load(ppu_context* ctx)
         (u32)ctx->gpr[10], (void*)(uintptr_t)savedata_arg9(ctx));
 }
 
+/* UserFixedSave has nine arguments; UserListAutoLoad has ten. Neither may
+ * use the generic eight-register bridge: the callbacks need stack userdata. */
+static void hle_cellSaveDataUserFixedSave(ppu_context* ctx)
+{
+    printf("[cellSaveData] UserFixedSave(user=%u)\n", (u32)ctx->gpr[4]);
+    if (ctx->gpr[4] > 1) {
+        ctx->gpr[3] = (u32)CELL_SAVEDATA_ERROR_PARAM; return;
+    }
+    ctx->gpr[3] = (uint64_t)(int64_t)savedata_fixed(1,
+        (CellSaveDataSetList*)(uintptr_t)(u32)ctx->gpr[5],
+        (CellSaveDataSetBuf*)(uintptr_t)(u32)ctx->gpr[6],
+        (CellSaveDataFixedCallback)(uintptr_t)(u32)ctx->gpr[7],
+        (CellSaveDataStatCallback)(uintptr_t)(u32)ctx->gpr[8],
+        (CellSaveDataFileCallback)(uintptr_t)(u32)ctx->gpr[9],
+        (void*)(uintptr_t)savedata_arg9(ctx));
+}
+
+static void hle_cellSaveDataUserListAutoLoad(ppu_context* ctx)
+{
+    printf("[cellSaveData] UserListAutoLoad(user=%u errDialog=%u)\n",
+           (u32)ctx->gpr[4], (u32)ctx->gpr[5]);
+    if (ctx->gpr[4] > 1 || ctx->gpr[5] > 2) {
+        ctx->gpr[3] = (u32)CELL_SAVEDATA_ERROR_PARAM; return;
+    }
+    u32 userdata = (u32)vm_read64((u32)ctx->gpr[1] + SAVEDATA_ARG9_SP_OFF + 8);
+    ctx->gpr[3] = (uint64_t)(int64_t)savedata_fixed(0,
+        (CellSaveDataSetList*)(uintptr_t)(u32)ctx->gpr[6],
+        (CellSaveDataSetBuf*)(uintptr_t)(u32)ctx->gpr[7],
+        (CellSaveDataFixedCallback)(uintptr_t)(u32)ctx->gpr[8],
+        (CellSaveDataStatCallback)(uintptr_t)(u32)ctx->gpr[9],
+        (CellSaveDataFileCallback)(uintptr_t)(u32)ctx->gpr[10],
+        (void*)(uintptr_t)userdata);
+}
+
+static int s_overlay_enabled;
+static void hle_cellSaveDataEnableOverlay(ppu_context* ctx)
+{
+    s_overlay_enabled = ctx->gpr[3] != 0;
+    ctx->gpr[3] = 0;
+}
+
 void cellSaveData_register_ctx_handlers(void)
 {
     /* Overrides the generated 8-arg registration: ctx handlers are dispatched
@@ -1572,6 +1621,12 @@ void cellSaveData_register_ctx_handlers(void)
                          hle_cellSaveDataUserAutoLoad);
     ps3_hle_register_ctx(0x52AAC4FAu, "cellSaveDataUserAutoSave",
                          hle_cellSaveDataUserAutoSave);
+    ps3_hle_register_ctx(0x40B34847u, "cellSaveDataUserFixedSave",
+                         hle_cellSaveDataUserFixedSave);
+    ps3_hle_register_ctx(0x248BD1D8u, "cellSaveDataUserListAutoLoad",
+                         hle_cellSaveDataUserListAutoLoad);
+    ps3_hle_register_ctx(0xE7FA820Bu, "cellSaveDataEnableOverlay",
+                         hle_cellSaveDataEnableOverlay);
 }
 
