+def collect_init_array_targets(buf, sections, insns_by_addr):
+    """ELF constructor/destructor arrays may contain just one code pointer.
+
+    Their section metadata identifies the pointer table, unlike the heuristic
+    three-entry minimum used for unknown data. Ignore legacy 0/-1 sentinels
+    and require an actual decoded instruction at every accepted address.
+    """
+    targets = set()
+    for section in sections:
+        if section.get("name") not in (".ctors", ".dtors", ".init_array",
+                                        ".fini_array", ".preinit_array"):
+            continue
+        start, size = section["off"], section["size"]
+        if start < 0 or size % 4 or start + size > len(buf):
+            raise ValueError("SPU initialization array outside ELF")
+        for offset in range(start, start + size, 4):
+            target = be_u32(buf, offset)
+            if target not in (0, 0xFFFFFFFF) and target % 4 == 0 and target in insns_by_addr:
+                targets.add(target)
+    return targets
+
